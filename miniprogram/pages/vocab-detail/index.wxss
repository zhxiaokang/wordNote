.word-card {
  margin: 24rpx 48rpx 0;
  padding: 64rpx 48rpx;
  text-align: center;
}
.word-text {
  font-size: 76rpx;
  font-weight: 900;
  color: #1C1C1E;
  font-family: Georgia, serif;
}
.added-badge {
  display: inline-block;
  margin-top: 24rpx;
  background: #E8F4FC;
  color: #3A9FD5;
  font-size: 22rpx;
  border-radius: 40rpx;
  padding: 6rpx 28rpx;
}

.section {
  padding: 28rpx 48rpx 0;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin: 28rpx 0 16rpx;
}
.section-title:first-child {
  margin-top: 0;
}

.meaning-card, .notes-card {
  padding: 28rpx 36rpx;
}
.meaning-row-view {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.meaning-row-view + .meaning-row-view {
  margin-top: 16rpx;
}
.meaning-row-view .pos {
  color: #3A9FD5;
  font-weight: 700;
  font-size: 28rpx;
  flex-shrink: 0;
}
.meaning-row-view .def {
  font-size: 28rpx;
  color: #1C1C1E;
}
.notes-card {
  font-size: 26rpx;
  line-height: 1.9;
  color: #3C3C43;
  white-space: pre-wrap;
}
.notes-empty {
  color: #C7C7CC;
}

.history-card {
  padding: 28rpx 36rpx;
}
.history-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}
.history-row:last-child {
  border-bottom: none;
}
.history-date {
  color: #8E8E93;
}
.action-added {
  color: #3A9FD5;
}
.action-correct {
  color: #34C759;
}
.action-incorrect {
  color: #FF3B30;
}

.word-input-edit {
  font-size: 56rpx;
  font-weight: 900;
  color: #1C1C1E;
  font-family: Georgia, serif;
  text-align: center;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
}

.edit-toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 48rpx 0;
}
.btn-pill {
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
}
.btn-pill--blue {
  background: #E8F4FC;
  color: #3A9FD5;
}
.btn-pill--gray {
  background: #F2F2F7;
  color: #8E8E93;
}
.btn-pill--disabled {
  background: #F2F2F7;
  color: #C7C7CC;
}

.meaning-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.pos-select {
  flex: 0 0 190rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pos-placeholder {
  font-size: 26rpx;
  color: #C7C7CC;
}
.pos-value {
  color: #3A9FD5;
  font-weight: 700;
}
.caret {
  font-size: 22rpx;
  color: #3A9FD5;
}
.def-input {
  flex: 1;
}
.remove-meaning {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: #C7C7CC;
  font-size: 32rpx;
}

.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
}
.dropdown {
  position: absolute;
  top: 100rpx;
  left: 0;
  width: 190rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.13);
  z-index: 10;
  overflow: hidden;
}
.dropdown-option {
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #3C3C43;
  border-bottom: 1rpx solid #E5E5EA;
}
.dropdown-option:last-child {
  border-bottom: none;
}
.dropdown-option--active {
  background: #E8F4FC;
  color: #3A9FD5;
  font-weight: 700;
}

.add-pos {
  display: inline-flex;
  align-items: center;
  background: #E8F4FC;
  color: #3A9FD5;
  font-size: 26rpx;
  border-radius: 20rpx;
  padding: 14rpx 36rpx;
  margin-bottom: 28rpx;
}

.notes-input {
  height: 200rpx;
}
