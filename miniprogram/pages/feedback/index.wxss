.feedback-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 0;
  box-sizing: border-box;
}
.feedback-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}
.feedback-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 20rpx;
}
.feedback-desc {
  font-size: 28rpx;
  color: #8E8E93;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 56rpx;
}
.email-card {
  width: 100%;
  margin: 0 0 32rpx;
  padding: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.email-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A9FD5;
}
.copy-btn {
  width: 100%;
}
