<view class="page-title">
  <text class="title">我的</text>
</view>

<view class="card checkin-card">
  <view class="card-title">📅 学习打卡</view>
  <view class="month-label">{{monthLabel}}</view>
  <view class="week-labels">
    <view class="week-cell" wx:for="{{weekdayLabels}}" wx:key="*this">{{item}}</view>
  </view>
  <view class="week-row" wx:for="{{weeks}}" wx:key="index" wx:for-item="week" wx:for-index="index">
    <view class="day-cell" wx:for="{{week}}" wx:key="dayIndex" wx:for-item="cell" wx:for-index="dayIndex">
      <block wx:if="{{cell}}">
        <view class="day-num {{cell.isToday ? 'day-num--today' : ''}}">{{cell.day}}</view>
        <view class="day-mark">{{cell.pending ? '—' : cell.emoji}}</view>
      </block>
    </view>
  </view>
  <view class="legend">
    <text>😊 全部完成</text>
    <text>😐 部分完成</text>
    <text>😢 未复习</text>
  </view>
</view>

<view class="card backup-card">
  <view class="card-title">💾 数据备份</view>
  <view class="backup-sub">单词和复习记录只保存在本机，换机或清理微信缓存前建议导出备份</view>
  <view class="backup-actions">
    <button class="btn btn-ghost backup-btn" bindtap="onTapExport">导出数据</button>
    <button class="btn btn-blue backup-btn" bindtap="onTapImport">导入数据</button>
  </view>
</view>

<view class="card nav-card" bindtap="onTapHelp">
  <view class="nav-row-hdr">
    <view class="card-title" style="margin-bottom:0">📖 使用说明</view>
    <text class="chevron">›</text>
  </view>
  <view class="nav-row-sub">复习、新词、词汇、我的各功能的使用说明</view>
</view>

<view class="card nav-card" bindtap="onTapFeedback">
  <view class="nav-row-hdr">
    <view class="card-title" style="margin-bottom:0">💬 用户反馈</view>
    <text class="chevron">›</text>
  </view>
  <view class="nav-row-sub">点击进入，提交建议或查看开发者回复</view>
</view>

<view class="modal-mask" wx:if="{{showImportModal}}">
  <view class="modal-box">
    <view class="modal-title">导入数据</view>
    <view class="modal-desc">粘贴此前导出的备份内容，将与本机数据合并（同一单词/日期以更新时间较新的为准）。</view>
    <textarea class="import-textarea" placeholder="粘贴导出的内容…" value="{{importDraft}}" bindinput="onImportDraftInput" />
    <view class="modal-actions">
      <button class="btn btn-ghost" bindtap="onCancelImport">取消</button>
      <button class="btn btn-blue" bindtap="onConfirmImport">导入</button>
    </view>
  </view>
</view>
