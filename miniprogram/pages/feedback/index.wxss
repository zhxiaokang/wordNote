.thread-card, .compose-card {
  margin: 28rpx 48rpx 0;
  padding: 32rpx 32rpx;
}
.thread-label {
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 16rpx;
}
.bubble {
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1C1C1E;
}
.bubble-mine {
  background: #E8F4FC;
}
.bubble-reply {
  background: #F2F2F7;
}
.ts {
  font-size: 22rpx;
  color: #C7C7CC;
  margin-top: 8rpx;
  text-align: right;
}
.empty-tip {
  text-align: center;
  color: #8E8E93;
  font-size: 26rpx;
  margin: 80rpx 0;
}
.compose-input {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #C7C7CC;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #1C1C1E;
  height: 180rpx;
  background: #F2F2F7;
}
.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  padding: 24rpx 0;
}
