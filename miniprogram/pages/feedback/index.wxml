<view class="feedback-page">
  <view class="feedback-icon">✉️</view>
  <text class="feedback-title">意见与反馈</text>
  <text class="feedback-desc">如果你在使用中遇到问题，或者有想法想要告诉开发者，欢迎发送邮件反馈。</text>

  <view class="card email-card">
    <text class="email-text">{{email}}</text>
  </view>

  <button class="btn btn-blue copy-btn" bindtap="onCopyEmailTap">复制邮箱</button>
</view>
