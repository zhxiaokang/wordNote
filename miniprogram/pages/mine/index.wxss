.card {
  margin: 28rpx 48rpx 0;
  padding: 36rpx 36rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 24rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx 36rpx;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.avatar-placeholder {
  background: #E8F4FC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
}
.login-sub {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}
.login-body {
  flex: 1;
}
.login-btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx 0;
}

.month-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #3A9FD5;
  margin-bottom: 16rpx;
  text-align: center;
}
.week-labels, .week-row {
  display: flex;
}
.week-cell {
  flex: 1;
  font-size: 22rpx;
  color: #8E8E93;
  text-align: center;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.day-cell {
  flex: 1;
  text-align: center;
  padding: 4rpx 0;
  min-height: 64rpx;
}
.day-num {
  font-size: 22rpx;
  color: #1C1C1E;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  margin: 0 auto;
  border-radius: 50%;
}
.day-num--today {
  background: #3A9FD5;
  color: #fff;
}
.day-mark {
  font-size: 26rpx;
  line-height: 1.4;
  min-height: 32rpx;
}
.legend {
  margin-top: 20rpx;
  display: flex;
  gap: 28rpx;
  justify-content: center;
  font-size: 22rpx;
  color: #8E8E93;
}

.feedback-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feedback-sub {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}
.chevron {
  font-size: 40rpx;
  color: #C7C7CC;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background: #fff;
  border-radius: 40rpx;
  width: 600rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-sizing: border-box;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 20rpx;
}
.modal-desc {
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-actions .btn {
  flex: 1;
  padding: 24rpx 0;
}
.btn-ghost {
  background: #F2F2F7;
  color: #3A9FD5;
}
