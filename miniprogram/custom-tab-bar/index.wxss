.nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 176rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #C7C7CC;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 100;
  box-sizing: border-box;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.nav-item.active {
  color: #3A9FD5;
}

.icon-wrap {
  border-radius: 28rpx;
  padding: 8rpx 36rpx;
  font-size: 36rpx;
  line-height: 1.4;
}

.nav-item.active .icon-wrap {
  background: #E8F4FC;
}
